# Copy to `backend/.env` (or export in your shell) — never commit real values.

# Comma-separated browser origins allowed by CORS.
# Default: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Set to 1 to allow ANY origin (development only — never in production).
CORS_ALLOW_ALL=

# Bind address/port for `uvicorn app.main:app --host $MICROSHIELD_HOST --port $MICROSHIELD_PORT`
MICROSHIELD_HOST=127.0.0.1
MICROSHIELD_PORT=8000
