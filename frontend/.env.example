# Copy to `frontend/.env` if you want a non-default backend URL.

# Base URL of the FastAPI backend, used when compute mode is set to "API".
# With the Vite dev server, leave this empty: /api requests are proxied to
# http://localhost:8000 automatically (see vite.config.ts).
VITE_API_BASE_URL=

# Dev-server proxy target for /api (defaults to http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000
